{
  "name": "kitsune-dm",
  "version": "0.2.2",
  "description": "Kitsune Download Manager desktop app",
  "desktopName": "kitsune-dm",
  "main": "./out/main/index.js",
  "author": {
    "name": "Oliver Marcusson",
    "email": "oliver@marcusson.dev"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "start": "electron-vite preview",
    "test": "tsx --test tests/*.test.*",
    "pack:dir": "npm run build:rust && npm run build && electron-builder --dir",
    "dist:linux": "npm run build:rust && npm run build && electron-builder --linux",
    "dist:win": "npm run build:rust && npm run build && electron-builder --win",
    "build:rust": "cargo build --release --manifest-path ../Cargo.toml -p kitsune-daemon -p kitsune-shim && cargo build --release --manifest-path ../Cargo.toml -p kitsune-cli --bin native-host-manifest"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "motion": "^14.0.0",
    "parse-torrent": "^11.0.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/webtorrent": "^3.0.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.4",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "allowScripts": {
    "electron@43.3.0": true,
    "node-datachannel@0.32.3": true
  },
  "homepage": "https://github.com/OliverMarcusson/Kitsune-Download-Manager"
}
